# Postgres connection string. Use "pglite:<dir>" for an embedded local database.
DATABASE_URL=pglite:.data/dev

# Public base URL used in emails and invite links. On Vercel it defaults to the production domain.
APP_URL=http://localhost:3000

# How sign-in emails are sent:
#   "outbox" stores them in the database and prints them to the console (local dev and tests only)
#   "gmail"  sends from a Gmail account with an app password (https://myaccount.google.com/apppasswords)
#   "resend" sends through Resend with a verified domain
MAIL_TRANSPORT=outbox
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# Optional sender name and address, e.g. "Mended <you@gmail.com>".
MAIL_FROM=

# Photo storage. When unset, photos are stored on local disk under .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Web push (generate with: npx web-push generate-vapid-keys). Push is disabled when unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Enables test-only helpers (fake clock cookie, outbox reader). Never set in production.
TEST_MODE=
